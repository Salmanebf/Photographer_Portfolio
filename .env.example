# Copy to .env.local for development. Everything is OPTIONAL locally:
# with nothing set, the site runs on placeholder content and a local SQLite file.
# In production, set these in your host's dashboard (same names on any host).
# Full list and what each does: README.md → "Environment variables".

# ============================================================
#  Site
# ============================================================
# Your real domain: used for canonical URLs, hreflang, Open Graph and the sitemap.
# NEXT_PUBLIC_* values are fixed when the site is BUILT — set it before you build/deploy.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================
#  Content — Sanity CMS (the admin dashboard at /studio)
#  Without these, the site uses the placeholder content in src/lib/site.config.ts and each
#  feature's content/ folder.
#  1. Create a project at sanity.io and copy its Project ID
#  2. In sanity.io/manage → API → CORS origins, add your site URL
#     (and http://localhost:3000) with credentials allowed
# ============================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# Draft preview (optional) — lets an editor see UNPUBLISHED changes on the real site.
#  SANITY_API_READ_TOKEN   : sanity.io → API → Tokens → add a token with "Viewer" rights.
#                            Server-side only; used solely when preview mode is on.
#  SANITY_PREVIEW_SECRET   : any long random string; protects the preview link
#                            https://your-site/api/draft?secret=<it>&path=/en
#                            Unset = preview is disabled.
SANITY_API_READ_TOKEN=""
SANITY_PREVIEW_SECRET=""

# Advanced / testing only: talk to another Sanity API address instead of the Sanity cloud,
# e.g. the fake one from `npm run cms:mock` (http://127.0.0.1:3333). Leave empty normally.
SANITY_API_HOST=""

# ============================================================
#  Video — Bunny Stream
#  Videos are referenced in content as `bunny:<video-id>`.
#  Create a Video Library at bunny.net, enable "MP4 Fallback", and
#  copy the library's CDN hostname (vz-xxxxxxxx-xxx.b-cdn.net).
#  Without it, Bunny videos show only their poster image.
# ============================================================
NEXT_PUBLIC_BUNNY_CDN_HOST=""

# ============================================================
#  Database — PostgreSQL (any provider). Stores contact messages.
#  This ONE value is the only thing that changes if you switch provider
#  (Neon, Supabase, Railway, RDS, your own server…).
#    Neon: create a project at neon.tech → Connect → copy the POOLED connection string
#    (host contains "-pooler") — best for Vercel/Netlify. Paste it UNCHANGED (the
#    ?sslmode=require part is fine). Full walkthrough: docs/SERVICES-SETUP.md
#  Required in production. Unset in development = an in-process Postgres
#  (stored in .pglite/), so nothing needs installing locally.
#  The table is created automatically on the first message.
# ============================================================
DATABASE_URL=""

# ============================================================
#  Email notification on new contact messages (optional) — Resend
#  Without it, messages are still saved to the database.
#  Resend's default sender only delivers to your own account email
#  until you verify a domain (then change `from` in
#  src/features/contact/handlers/email.ts).
# ============================================================
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""

# ============================================================
#  Admin access to stored contact messages (optional)
#  Enables GET /api/contact with `Authorization: Bearer <token>`.
#  Leave empty to disable the endpoint. Use a long random value.
# ============================================================
CONTACT_ADMIN_TOKEN=""

# ============================================================
#  Build option (not a secret, build time only)
#  BUILD_STANDALONE=1 npm run build   → self-contained server for Docker/VPS.
#  Do NOT set it on Vercel/Netlify.
# ============================================================
