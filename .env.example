# ============================================================
#  Database (Prisma + SQLite, used by /api/contact)
# ============================================================
DATABASE_URL="file:./db/custom.db"

# ============================================================
#  Sanity CMS (optional)
#  ----------------------------------------------------------
#  Without these, the site renders fine using static fallbacks
#  in src/lib/site.config.ts and src/lib/data.ts.
#
#  To enable a CMS that non-developers can edit:
#   1. Sign up free at sanity.io
#   2. Create a project, copy the project ID
#   3. Set the values below in your .env.local
#   4. Visit /studio to start editing
# ============================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# ============================================================
#  Email (optional — for contact form)
#  ----------------------------------------------------------
#  Without this, contact submissions still save to the DB —
#  just no email notification.
#  Get a free API key at resend.com.
# ============================================================
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""

# ============================================================
#  Public site URL (used by sitemap.xml)
# ============================================================
NEXT_PUBLIC_SITE_URL="https://alexrivera.film"

# ============================================================
#  Analytics (optional — Vercel Analytics)
# ============================================================
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
