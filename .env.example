# Copy to .env.local for development. Everything is OPTIONAL locally:
# with nothing set, the site runs on placeholder content and a local SQLite file.
# In production, set these in your host's dashboard (same names on any host).
# Full list and what each does: README.md → "Environment variables".

# ============================================================
#  Site
# ============================================================
# Your real domain: used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================
#  Content — Sanity CMS (the admin dashboard at /studio)
#  Without these, the site uses src/lib/site.config.ts + data.ts.
#  1. Create a project at sanity.io and copy its Project ID
#  2. In sanity.io/manage → API → CORS origins, add your site URL
#     (and http://localhost:3000) with credentials allowed
# ============================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# ============================================================
#  Video — Bunny Stream
#  Videos are referenced in content as `bunny:<video-id>`.
#  Create a Video Library at bunny.net, enable "MP4 Fallback", and
#  copy the library's CDN hostname (vz-xxxxxxxx-xxx.b-cdn.net).
#  Without it, Bunny videos show only their poster image.
# ============================================================
NEXT_PUBLIC_BUNNY_CDN_HOST=""

# ============================================================
#  Database — Turso (libSQL, SQLite-compatible). Stores contact messages.
#  Production: create a database at turso.tech (or via Vercel's Turso
#  integration, which sets these two for you).
#  Unset = a local file `local.db` (development only; hosted platforms
#  do not keep local files). The table is created automatically.
# ============================================================
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ============================================================
#  Email notification on new contact messages (optional) — Resend
#  Without it, messages are still saved to the database.
#  Resend's default sender only delivers to your own account email
#  until you verify a domain (then change `from` in
#  src/features/contact/handlers/email.ts).
# ============================================================
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""

# ============================================================
#  Admin access to stored contact messages (optional)
#  Enables GET /api/contact with `Authorization: Bearer <token>`.
#  Leave empty to disable the endpoint. Use a long random value.
# ============================================================
CONTACT_ADMIN_TOKEN=""

# ============================================================
#  Build option (not a secret, build time only)
#  BUILD_STANDALONE=1 npm run build   → self-contained server for Docker/VPS.
#  Do NOT set it on Vercel/Netlify.
# ============================================================
